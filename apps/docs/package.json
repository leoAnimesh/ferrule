{
  "name": "ferrule-docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "prepare-site": "node ../../packages/ferrule/bin/ferrule.js add --all --overwrite && node scripts/gen-content.mjs",
    "start": "pnpm prepare-site && expo start --web --port 8092",
    "build": "pnpm prepare-site && expo export --platform web --output-dir dist && node scripts/post-export.mjs",
    "typecheck": "pnpm prepare-site && tsc --noEmit",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.0",
    "expo": "~58.0.23",
    "ferrule": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.7",
    "marked": "^15.0.0",
    "shiki": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
